# Copiar a .env (cp .env.example .env). El archivo .env no se sube al repositorio.

# Django
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dirección pública del sitio (se usa en los enlaces de los correos)
SITE_URL=http://localhost:8000

# PostgreSQL (lo usan los dos servicios: db y web)
POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=siga

# Correo. Por defecto se imprime en la consola: docker compose logs -f web
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SIGA ITS N.º 1 <siga_dev.its@gmail.com>
# Para enviar de verdad por SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
