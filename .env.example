# Copiar a .env (cp .env.example .env). El archivo .env no se sube al repositorio.

# Django
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Dirección pública del sitio (se usa en los enlaces de los correos)
SITE_URL=http://localhost:8000

# PostgreSQL (lo usan los dos servicios: db y web)
POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=siga

# Correo (cuenta de Gmail del proyecto)
# Mientras EMAIL_HOST_PASSWORD esté vacío, los correos NO se envían:
# se imprimen en la consola (docker compose logs -f web).
# Al completar usuario y contraseña de aplicación, se envían por Gmail.
# Probar con: docker compose exec web python manage.py probar_correo tu@correo.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=siga_dev.its@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIGA ITS N.º 1 <siga_dev.its@gmail.com>
