# Instalacion nueva: Copy-Item .env.example .env (PowerShell).
# Si .env ya existe, conservarlo y completar las variables que falten.
# Las claves siguientes son ejemplos locales: reemplazarlas antes del primer arranque.

# Django
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SIGA_PORT=8000
SITE_URL=http://localhost:8000

# PostgreSQL de SIGA (servicios siga_db y web)
POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=CambiarClaveSiga2026!

# Correo de SIGA. Sin EMAIL_HOST_PASSWORD, se imprime en la consola.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=siga_dev.its@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIGA ITS N. 1 <siga_dev.its@gmail.com>

# Integracion REST con servidor Moodle externo (opcional / Extension 3)
# Poner MOODLE_ACTIVO=0 para probar el aplicativo sin hacer peticiones a Moodle,
# o MOODLE_ACTIVO=1 para crear/vincular usuarios por API REST al aceptar.
MOODLE_ACTIVO=0
MOODLE_URL=http://localhost:8080
MOODLE_HOST_HEADER=localhost:8080
MOODLE_API_TOKEN=
