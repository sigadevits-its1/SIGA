# Instalacion nueva: Copy-Item .env.example .env (PowerShell).
# Si .env ya existe, conservarlo y completar las variables que falten.
# Las claves siguientes son ejemplos locales: reemplazarlas antes del primer arranque.

# Django
DJANGO_SECRET_KEY=cambiar-esta-clave-en-produccion
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
SIGA_PORT=8000
SITE_URL=http://localhost:8000

# PostgreSQL de SIGA (servicios siga_db y web)
POSTGRES_DB=siga
POSTGRES_USER=siga
POSTGRES_PASSWORD=CambiarClaveSiga2026!

# Correo de SIGA. Sin EMAIL_HOST_PASSWORD, se imprime en la consola.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=siga_dev.its@gmail.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SIGA ITS N. 1 <siga_dev.its@gmail.com>

# Moodle: direccion del navegador y puerto publicado en la PC.
MOODLE_PORT=8080
MOODLE_SITE_URL=http://localhost:8080
MOODLE_SITENAME=Moodle

# Moodle: direccion INTERNA que usa Django en la red del Compose.
# No usar localhost aqui: apuntaria al propio contenedor de Django.
MOODLE_URL=http://moodle:8080
# Host y puerto de MOODLE_SITE_URL, sin esquema ni barra final.
MOODLE_HOST_HEADER=localhost:8080
# Crear el token del servicio externo siga siguiendo el README y pegarlo aqui.
MOODLE_API_TOKEN=

# PostgreSQL de Moodle (servicios moodle_db y moodle; distinto al de SIGA).
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodleuser
MOODLE_DB_PASSWORD=CambiarClaveBaseMoodle2026!

# Administrador inicial de Moodle. Se usa al instalar sobre volumenes vacios.
# No es la cuenta tecnica del webservice ni cambia una cuenta existente.
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CambiarAdminMoodle2026!
MOODLE_ADMIN_EMAIL=admin@example.com

# Persistencia. Estos nombres crean una instalacion nueva.
# Para reutilizar datos de los dos Compose anteriores, ver el README.
EXTERNAL_DATA_VOLUMES=false
SIGA_DB_VOLUME=siga_pgdata
SIGA_MEDIA_VOLUME=siga_media
MOODLE_DB_VOLUME=siga_moodle_pgdata
MOODLE_DATA_VOLUME=siga_moodledata
MOODLE_HTML_VOLUME=siga_moodlehtml
